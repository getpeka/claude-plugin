{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/runtime/peka",
            "args": [
              "wait",
              "--pair"
            ],
            "asyncRewake": true,
            "timeout": 604800
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "claude.ai peka",
            "tool": "register_session",
            "input": {
              "session_id": "${session_id}"
            },
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "matcher": "peka-cloud:login",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/runtime/peka",
            "args": [
              "login"
            ],
            "timeout": 20
          }
        ]
      }
    ]
  }
}
