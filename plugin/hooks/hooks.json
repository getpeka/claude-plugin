{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/runtime/peka",
            "args": ["wait"],
            "asyncRewake": true,
            "timeout": 604800
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "matcher": "peka:login",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/runtime/peka",
            "args": ["login"],
            "timeout": 20
          }
        ]
      }
    ]
  }
}
