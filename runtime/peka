#!/bin/sh
# Runs the peka session client built for this computer. On Windows, Claude Code starts
# peka.exe next to this file instead.
dir=$(dirname "$0")
case "$(uname -s)-$(uname -m)" in
  Darwin-arm64) exec "$dir/peka-darwin-arm64" "$@" ;;
  Darwin-x86_64) exec "$dir/peka-darwin-x64" "$@" ;;
  Linux-x86_64) exec "$dir/peka-linux-x64" "$@" ;;
  Linux-aarch64 | Linux-arm64) exec "$dir/peka-linux-arm64" "$@" ;;
  MINGW* | MSYS* | CYGWIN*) exec "$dir/peka.exe" "$@" ;;
esac
echo "peka: there's no session client for $(uname -s) $(uname -m) in $dir" >&2
exit 1
